# Environment Variables Example
# Copy this file to .env and fill in the values
# DO NOT commit .env to Git!

# Crypto Master Key (REQUIRED for production)
# Generate using: ./scripts/generate-master-key.sh
# Format: Base64-encoded 32-byte (256-bit) AES key
APP_CRYPTO_MASTER_KEY=

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/notifications
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Port
SERVER_PORT=1310

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:1015,http://localhost:4200,http://localhost:8080
