# Environment Variables Example
# Copy this file to .env and fill in the values

# =============================================================================
# CRYPTO CONFIGURATION (REQUIRED for production)
# =============================================================================
# Format: Base64-encoded 32-byte (256-bit) AES key
APP_CRYPTO_MASTER_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/notifications
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Key Prefixes
APP_REDIS_KEY_PREFIX_ADMIN_RATE_LIMIT=admin:ratelimit:

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# =============================================================================
# ADMIN CREDENTIALS (HTTP Basic Auth)
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=1310

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:1015,http://localhost:4200,http://localhost:8080,http://localhost:1310

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TYPE=redis

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Timestamp window for HMAC signature validation (prevents replay attacks)
APP_AUTH_TIMESTAMP_WINDOW_MS=120000

# =============================================================================
# NOTIFICATION PROCESSING CONFIGURATION
# =============================================================================
# Random delay range for simulating async notification processing (milliseconds)
APP_NOTIFICATION_DELAY_MIN_MS=1000
APP_NOTIFICATION_DELAY_MAX_MS=3000

# =============================================================================
# RATE LIMITER CONFIGURATION
# =============================================================================
# Soft throttle jitter delay (random delay when throttling)
APP_RATE_LIMITER_JITTER_MIN_MS=50
APP_RATE_LIMITER_JITTER_MAX_MS=200

# Default thresholds (used as fallback)
APP_RATE_LIMITER_SOFT_THROTTLE_THRESHOLD=0.80
APP_RATE_LIMITER_HARD_REJECT_THRESHOLD=1.00

# Retry delay for invalid API keys (seconds)
APP_RATE_LIMITER_INVALID_API_KEY_RETRY_DELAY_SECONDS=60

# =============================================================================
# DEFAULT CLIENT LIMITS CONFIGURATION
# =============================================================================
# Used when creating new clients
APP_DEFAULT_CLIENT_LIMITS_WINDOW_SIZE_SECONDS=60
APP_DEFAULT_CLIENT_LIMITS_MAX_REQUESTS_PER_WINDOW=100
APP_DEFAULT_CLIENT_LIMITS_MONTHLY_QUOTA=10000
APP_DEFAULT_CLIENT_LIMITS_SOFT_THROTTLE_THRESHOLD=0.80
APP_DEFAULT_CLIENT_LIMITS_HARD_REJECT_THRESHOLD=1.00

# =============================================================================
# ADMIN RATE LIMITER CONFIGURATION
# =============================================================================
APP_ADMIN_RATE_LIMITER_WINDOW_SECONDS=300
APP_ADMIN_RATE_LIMITER_MAX_REQUESTS=100

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# API key validation cache TTL (hours)
APP_CACHE_API_KEY_VALIDATION_TTL_HOURS=24
# Default cache TTL (minutes)
APP_CACHE_DEFAULT_TTL_MINUTES=5
# Caffeine cache max size
APP_CACHE_CAFFEINE_MAX_SIZE=500

# =============================================================================
# PAGINATION CONFIGURATION
# =============================================================================
APP_PAGINATION_DEFAULT_SIZE=20
APP_PAGINATION_MAX_SIZE=100

# =============================================================================
# API KEY GENERATION CONFIGURATION
# =============================================================================
# Key bytes (256 bits = 32 bytes)
APP_API_KEY_KEY_BYTES=32
# Maximum attempts to generate unique key
APP_API_KEY_MAX_ATTEMPTS=10
# API key prefix
APP_API_KEY_PREFIX=LM

# =============================================================================
# API SECRET CONFIGURATION
# =============================================================================
# Secret bytes (512 bits = 64 bytes)
APP_API_SECRET_SECRET_BYTES=64

# =============================================================================
# FILTER CONFIGURATION
# =============================================================================
# Paths to skip authentication/rate limiting (comma-separated)
# Use ** for wildcard matching (e.g., /actuator/** matches all actuator paths)
APP_FILTER_SKIP_PATHS=/health,/actuator/health,/actuator/**,/admin/**,/swagger-ui**,/v3/api-docs**,/api-docs**,/error**

# Masking configuration for logging (privacy)
# API key: show last N characters
APP_FILTER_MASKING_API_KEY_VISIBLE_CHARS=4
# Recipient: show first N and last N characters
APP_FILTER_MASKING_RECIPIENT_VISIBLE_CHARS=3
# IP address: show first N characters for IPv6
APP_FILTER_MASKING_IP_VISIBLE_CHARS=8

# =============================================================================
# OPENAPI/SWAGGER CONFIGURATION
# =============================================================================
APP_OPENAPI_INFO_TITLE=Irembo Notifications API
APP_OPENAPI_INFO_VERSION=1.0.0
APP_OPENAPI_INFO_DESCRIPTION=Distributed notification API with sophisticated rate limiting
APP_OPENAPI_INFO_CONTACT_NAME=Irembo Engineering
APP_OPENAPI_INFO_CONTACT_EMAIL=engineering@irembo.com
APP_OPENAPI_INFO_LICENSE_NAME=MIT License
APP_OPENAPI_INFO_LICENSE_URL=https://opensource.org/licenses/MIT
APP_OPENAPI_SERVER_URL=http://localhost:8080
APP_OPENAPI_SERVER_DESCRIPTION=Development server
