				{
					"name": "Create New Client",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains client details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('apiKey');",
									"    pm.expect(jsonData.name).to.equal(\"Demo Client\");",
									"    pm.expect(jsonData.priority).to.equal(5);",
									"});",
									"",
									"// Save client ID for later use",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"demo_client_id\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
