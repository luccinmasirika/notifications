		{
			"name": "Rate Limiting Demo",
			"item": [
				{
					"name": "Burst Test - Send 85 Requests",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// This script sends 85 requests rapidly to approach soft throttle threshold (80%)",
									"const baseUrl = pm.environment.get(\"base_url\");",
									"const apiKey = pm.environment.get(\"api_key\");",
									"",
									"for (let i = 0; i < 84; i++) {",
									"    pm.sendRequest({",
									"        url: baseUrl + \"/api/notifications\",",
									"        method: \"POST\",",
									"        header: {",
									"            \"X-API-KEY\": apiKey,",
									"            \"Content-Type\": \"application/json\"",
									"        },",
									"        body: {",
									"            mode: \"raw\",",
									"            raw: JSON.stringify({",
									"                channel: \"SMS\",",
									"                to: \"+250788123456\",",
									"                message: \"Burst test \" + i",
									"            })",
									"        }",
									"    }, function (err, res) {",
									"        if (i % 20 === 0) {",
									"            console.log(\"Sent \" + i + \" requests\");",
									"        }",
									"    });",
									"}",
									"",
									"console.log(\"Burst of 84 requests sent. Now execute this request to see soft throttle.\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Should be soft throttled or accepted\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([202, 202]);",
									"});",
									"",
									"pm.test(\"X-Soft-Throttled header may be present\", function () {",
									"    // Check if soft throttled",
									"    if (pm.response.headers.has(\"X-Soft-Throttled\")) {",
									"        console.log(\"SOFT THROTTLE TRIGGERED\");",
									"        pm.expect(pm.response.headers.get(\"X-Soft-Throttled\")).to.equal(\"true\");",
									"    }",
									"});",
									"",
									"// Log rate limit status",
									"console.log(\"Remaining: \" + pm.response.headers.get(\"X-RateLimit-Remaining\"));",
									"console.log(\"Limit: \" + pm.response.headers.get(\"X-RateLimit-Limit\"));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"channel\": \"SMS\",\n    \"to\": \"+250788123456\",\n    \"message\": \"Request #85 - should trigger soft throttle\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/notifications",
							"host": ["{{base_url}}"],
							"path": ["api", "notifications"]
						},
						"description": "**Pre-request script sends 84 requests**, then this request (85th) should trigger soft throttle.\n\n**Expected behavior:**\n- Usage: 85/100 = 85% (above 80% threshold)\n- Response: 202 Accepted with X-Soft-Throttled: true header\n- Added delay: 50-200ms random jitter\n\n**How to use:**\n1. Click \"Send\" once\n2. Pre-request script will send 84 requests automatically\n3. This 85th request will show soft throttle behavior\n4. Check console for logs and response headers"
					},
					"response": []
				},
				{
					"name": "Exhaust Limit - Hard Reject (429)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Send remaining requests to exhaust the limit (100 total)",
									"const baseUrl = pm.environment.get(\"base_url\");",
									"const apiKey = pm.environment.get(\"api_key\");",
									"",
									"// Assuming 85 were sent in previous test, send 15 more to reach 100",
									"for (let i = 85; i < 100; i++) {",
									"    pm.sendRequest({",
									"        url: baseUrl + \"/api/notifications\",",
									"        method: \"POST\",",
									"        header: {",
									"            \"X-API-KEY\": apiKey,",
									"            \"Content-Type\": \"application/json\"",
									"        },",
									"        body: {",
									"            mode: \"raw\",",
									"            raw: JSON.stringify({",
									"                channel: \"SMS\",",
									"                to: \"+250788123456\",",
									"                message: \"Exhaust test \" + i",
									"            })",
									"        }",
									"    }, function (err, res) {",
									"        console.log(\"Request \" + i + \": \" + res.code);",
									"    });",
									"}",
									"",
									"console.log(\"Limit exhausted. This 101st request should be hard rejected.\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 429 Too Many Requests\", function () {",
									"    pm.response.to.have.status(429);",
									"});",
									"",
									"pm.test(\"Retry-After header is present\", function () {",
									"    pm.response.to.have.header(\"Retry-After\");",
									"    var retryAfter = parseInt(pm.response.headers.get(\"Retry-After\"));",
									"    pm.expect(retryAfter).to.be.above(0);",
									"    console.log(\"Retry after: \" + retryAfter + \" seconds\");",
									"});",
									"",
									"pm.test(\"Standard error format with rate limit message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"    pm.expect(jsonData.error).to.include('Rate limit');",
									"    pm.expect(jsonData).to.have.property('status', 429);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"channel\": \"SMS\",\n    \"to\": \"+250788123456\",\n    \"message\": \"This should be rejected - request #101\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/notifications",
							"host": ["{{base_url}}"],
							"path": ["api", "notifications"]
						},
						"description": "**Pre-request script exhausts the rate limit** (sends requests 85-100), then this request (101st) triggers hard reject.\n\n**Expected behavior:**\n- Usage: 101/100 = 101% (at/above 100% threshold)\n- Response: 429 Too Many Requests\n- Headers: Retry-After with seconds until reset\n- Body: Standard error format with \"Rate limit exceeded\" message\n\n**How to use:**\n1. Run \"Burst Test\" first to send 85 requests\n2. Click \"Send\" on this request\n3. Pre-request script sends 15 more (total 100)\n4. This 101st request will be hard rejected with 429"
					},
					"response": []
				},
				{
					"name": "Check Current Rate Limit Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var remaining = pm.response.headers.get(\"X-RateLimit-Remaining\");",
									"var limit = pm.response.headers.get(\"X-RateLimit-Limit\");",
									"var reset = pm.response.headers.get(\"X-RateLimit-Reset\");",
									"",
									"console.log(\"====== RATE LIMIT STATUS ======\");",
									"console.log(\"Limit: \" + limit);",
									"console.log(\"Remaining: \" + remaining);",
									"console.log(\"Reset: \" + reset);",
									"console.log(\"Usage: \" + ((limit - remaining) / limit * 100).toFixed(2) + \"%\");",
									"",
									"if (pm.response.code === 202) {",
									"    console.log(\"Status: ALLOWED\");",
									"} else if (pm.response.code === 429) {",
									"    console.log(\"Status: HARD REJECTED\");",
									"}",
									"",
									"if (pm.response.headers.has(\"X-Soft-Throttled\")) {",
									"    console.log(\"Soft Throttled: YES\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"channel\": \"SMS\",\n    \"to\": \"+250788123456\",\n    \"message\": \"Status check\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/notifications",
							"host": ["{{base_url}}"],
							"path": ["api", "notifications"]
						},
						"description": "Send a notification and check the rate limit headers to see current status.\n\nThe test script will log:\n- Current limit\n- Remaining requests\n- Reset time\n- Usage percentage\n- Whether soft throttled or hard rejected"
					},
					"response": []
				}
			],
			"description": "Demonstrate rate limiting behavior with burst tests to trigger soft throttle and hard reject."
		},
		{
