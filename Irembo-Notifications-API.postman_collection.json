						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/admin/clients",
							"host": ["{{base_url}}"],
							"path": ["admin", "clients"]
						},
						"description": "List all registered clients. Requires HTTP Basic Auth."
					},
					"response": []
