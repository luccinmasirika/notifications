          <!-- Check for X-Soft-Throttled header -->
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Check Soft Throttle Header" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def softThrottled = prev.getResponseHeaders().contains(&quot;X-Soft-Throttled: true&quot;)
if (softThrottled) {
    log.info(&quot;✓ SOFT THROTTLE DETECTED - Request accepted with throttling&quot;)
} else {
    log.info(&quot;- No soft throttle yet (usage may be below 80%)&quot;)
}
</stringProp>
