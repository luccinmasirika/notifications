          <!-- Check for Retry-After header -->
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Check Retry-After Header" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def headers = prev.getResponseHeaders()
def retryAfter = headers.split(&quot;\n&quot;).find { it.startsWith(&quot;Retry-After:&quot;) }

if (retryAfter) {
    log.info(&quot;✓ HARD REJECT DETECTED - ${retryAfter}&quot;)
} else {
    log.warn(&quot;⚠ Expected Retry-After header not found&quot;)
}
</stringProp>
